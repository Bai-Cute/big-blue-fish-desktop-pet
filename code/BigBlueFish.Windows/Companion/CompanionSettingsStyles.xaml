<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#31405E"/>
        <Setter Property="Background" Value="#EDF3FC"/>
        <Setter Property="BorderBrush" Value="#DCE5F2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#DCEAFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#C9DDFC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#5478BD"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#31405E"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent" MinHeight="40">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
                    <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#CBD5E3" VerticalAlignment="Center">
                        <Ellipse x:Name="Knob" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#597CC8"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#233D72"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#F7F9FD"/><Setter Property="Foreground" Value="#31405E"/>
        <Setter Property="BorderBrush" Value="#DCE5F2"/><Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border Background="#F7F9FD" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="⌄" FontSize="16" Foreground="#647696" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        </Border>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,7,30,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#EDF3FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#DCEAFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Margin" Value="0,7,0,12"/><Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" Margin="2,0" VerticalAlignment="Center" Height="22">
                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#597CC8"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#597CC8" Stroke="White" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#DCE5F2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
