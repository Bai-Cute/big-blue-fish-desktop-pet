<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>BigBlueFish.InstallerVerification.Checks</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CompanionInputMode)' == 'Ocr'">
    <DefineConstants>$(DefineConstants);COMPANION_OCR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../installer/Program.cs" Link="Installer.cs" />
  </ItemGroup>
</Project>
